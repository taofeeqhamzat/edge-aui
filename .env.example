# Edge-AUI testbed — environment template
#
# Copy to `.env.local` for local development and add the same values to the
# Cloudflare Pages project environment variables for the deployment.
#
# Only PUBLIC values belong here. The Supabase **anon** key is public by design: it is
# shipped to every browser and its privileges are bounded by the Row Level Security policies
# in `supabase/migrations/0002_rls_policies.sql`, which grant INSERT and nothing else.
#
# NEVER put a Supabase `service_role` key in this file or in any build variable. It bypasses
# RLS entirely, so embedding it would give every visitor read/write access to all research
# telemetry. Researcher export uses the service-role key from a server-side shell only; see
# `docs/deploy/supabase-setup.md`.

# ---------------------------------------------------------------------------
# Research collection (optional)
# ---------------------------------------------------------------------------
# Leaving these unset is a supported configuration. The testbed then records sessions
# locally, exports traces as JSON from the research panel, and reports
# `collection: local_only` instead of attempting any upload.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Public anon key (Project Settings → API → Project API keys → anon/public)
VITE_SUPABASE_ANON_KEY=

# How much telemetry this build may upload:
#   off      = never upload; local recording and manual export only
#   scripted = upload only traces whose provenance is 'scripted'  (default)
#   all      = upload any provenance, including participant
#
# `participant` provenance requires an approved research protocol and a consent workflow that
# this milestone does not implement, so `scripted` is the correct value until that changes.
# See ADR-018.
VITE_AUI_COLLECTION_MODE=scripted

# ---------------------------------------------------------------------------
# Diagnostics (optional)
# ---------------------------------------------------------------------------
# The research panel is always available in a development build. In a production build it is
# reachable with `?auiDiagnostics=1` in the URL, or force it on for a researcher build by
# setting this to 1. Leave unset for a clean participant-facing build.
VITE_AUI_DIAGNOSTICS=
